---
import Layout from '../layouts/Layout.astro';
import FlipClockTimer from '../components/FlipClockTimer';
---

<Layout
  title="GTA VI: An Extended Look Countdown - Netflix Premiere"
  description="Watch the Grand Theft Auto VI: An Extended Look premiere countdown. Streaming August 27, 2026 on Netflix."
>
  <div class="background-slider" aria-hidden="true">
    <div class="background-slide is-active" style="background-image:url('/extra/Jason_and_Lucia_Robbery_landscape.jpg')"></div>
  </div>
  <div class="atmosphere" aria-hidden="true"></div>
  <div class="event-background" aria-hidden="true"></div>

  <main class="content">
    <header class="hero">
      <h1 class="sr-only" id="page-heading">GTA VI An Extended Look countdown</h1>
      <p class="eyebrow" id="hero-eyebrow">Rockstar Games presents</p>
      <img src="/assets/GTA6Logo.webp" class="gta-logo" alt="Grand Theft Auto VI" />
      <h2 class="event-title">An Extended Look</h2>
      <p class="release-line" id="release-line">August 27, 2026 &middot; 3 PM ET &middot; <span class="netflix-word" role="img" aria-label="Netflix"><img src="/assets/215-2154144_transparent-background-netflix-logo.png" alt="" aria-hidden="true" /></span></p>
    </header>

    <section class="countdown-grid" id="countdown" aria-label="Time until Netflix Extended Look premiere" role="timer" aria-live="off">
      <div class="time-box"><div class="number" id="days"><span class="number-value">0</span></div><span class="label">Days</span></div>
      <div class="time-box"><div class="number" id="hours"><span class="number-value">0</span></div><span class="label">Hours</span></div>
      <div class="time-box"><div class="number" id="minutes"><span class="number-value">0</span></div><span class="label">Minutes</span></div>
      <div class="time-box"><div class="number" id="seconds"><span class="number-value">0</span></div><span class="label">Seconds</span></div>
      <FlipClockTimer client:only="react" />
    </section>

    <a class="official-link" id="official-link" href="https://www.netflix.com/GTAVI" target="_blank" rel="noopener noreferrer">
      <span class="official-link-text">Watch An Extended Look on Netflix</span>
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
  </main>

  <a class="utility-button view-switch-test" href="/" aria-label="Return to GTA VI release countdown" title="GTA VI release countdown" style="display:inline-flex;">
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m9 6 6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </a>

  <footer class="site-footer">
    <div class="footer-inner">
      <p class="footer-disclaimer"><strong>Fan-made GTA VI countdown.</strong>Not affiliated with or endorsed by Rockstar Games, Take-Two Interactive, or Netflix.<br />All trademarks and imagery belong to their respective owners.</p>
      <div class="footer-lower">
        <p class="footer-copyright">&copy; 2026 gtavi.ghostwebstudios.com. All rights reserved.</p>
        <nav class="social-links" aria-label="Ghost Web Studios social media">
          <a class="social-link" href="https://x.com/ghostwebstudios" target="_blank" rel="noopener noreferrer" aria-label="Ghost Web Studios on X"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.9 2H22l-6.77 7.74L23.2 22h-6.24l-4.89-6.39L6.48 22H3.36l7.26-8.3L2.97 2h6.4l4.42 5.84L18.9 2Zm-1.1 17.84h1.72L8.43 4.05H6.58L17.8 19.84Z"/></svg></a>
          <a class="social-link" href="https://www.youtube.com/@ghostwebstudios" target="_blank" rel="noopener noreferrer" aria-label="Ghost Web Studios on YouTube"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8ZM9.6 15.6V8.4l6.2 3.6-6.2 3.6Z"/></svg></a>
        </nav>
      </div>
    </div>
  </footer>

  <script>
    import { calculateTimeRemaining, EXTENDED_LOOK_DATE } from '../utils/countdown';

    document.body.classList.add('extended-view');
    let countdownTarget = EXTENDED_LOOK_DATE;
    window.dispatchEvent(new CustomEvent('countdown:target', { detail: countdownTarget.getTime() }));

    const elements: Record<string, HTMLElement | null> = {
      days: document.getElementById('days'),
      hours: document.getElementById('hours'),
      minutes: document.getElementById('minutes'),
      seconds: document.getElementById('seconds')
    };
    const previous: Record<string, string> = {};
    const countdown = document.getElementById('countdown')!;
    const officialLinkText = document.querySelector<HTMLElement>('.official-link-text')!;
    const officialLink = document.getElementById('official-link') as HTMLAnchorElement;

    officialLink.addEventListener('click', (event) => {
      event.preventDefault();
      if (document.body.classList.contains('netflix-intro-playing')) return;
      document.body.classList.add('netflix-intro-playing');
      const intro = document.createElement('div');
      intro.className = 'netflix-intro';
      intro.innerHTML = '<video class="netflix-intro-video" src="/assets/netflix-intro.mp4" autoplay playsinline preload="auto"></video>';
      document.body.appendChild(intro);
      const video = intro.querySelector<HTMLVideoElement>('video')!;
      let opened = false;
      let fallbackTimer = 0;
      const netflixUrl = officialLink.href;
      const openNetflix = () => {
        if (opened) return;
        opened = true;
        window.clearTimeout(fallbackTimer);
        window.location.assign(netflixUrl);
      };
      video.addEventListener('ended', openNetflix, { once: true });
      video.addEventListener('error', openNetflix, { once: true });
      video.addEventListener('loadedmetadata', () => {
        const maximumWait = Number.isFinite(video.duration)
          ? Math.max(5000, (video.duration + 2) * 1000)
          : 30000;
        fallbackTimer = window.setTimeout(openNetflix, maximumWait);
      }, { once: true });
      video.play().catch(openNetflix);
      fallbackTimer = window.setTimeout(openNetflix, 30000);
    });

    function setValue(name: string, value: string) {
      if (previous[name] === value) return;
      const element = elements[name];
      if (!element) return;
      element.setAttribute('aria-label', value);
      const valElem = element.querySelector<HTMLElement>('.number-value');
      if (valElem) valElem.textContent = value;
      element.classList.remove('tick');
      void element.offsetWidth;
      element.classList.add('tick');
      window.dispatchEvent(new CustomEvent(`countdown:${name}`, { detail: value }));
      previous[name] = value;
    }

    function updateCountdown() {
      const values = calculateTimeRemaining(countdownTarget);
      const isComplete = Date.now() >= countdownTarget.getTime();
      const completionStarted = document.body.classList.contains('countdown-ending') || document.body.classList.contains('countdown-complete');
      if (isComplete && !completionStarted) {
        countdown.style.setProperty('--countdown-height', `${countdown.getBoundingClientRect().height}px`);
        const content = document.querySelector<HTMLElement>('.content')!;
        const hero = content.querySelector<HTMLElement>('.hero')!;
        content.style.setProperty('--completion-top', `${hero.getBoundingClientRect().top - content.getBoundingClientRect().top}px`);
        void countdown.offsetHeight;
        document.body.classList.add('countdown-ending');
        window.setTimeout(() => {
          if (Date.now() < countdownTarget.getTime()) return;
          document.body.classList.remove('countdown-ending');
          document.body.classList.add('countdown-complete');
        }, 1200);
      } else if (!isComplete && completionStarted) {
        document.body.classList.remove('countdown-ending', 'countdown-complete');
        countdown.style.removeProperty('--countdown-height');
        document.querySelector<HTMLElement>('.content')?.style.removeProperty('--completion-top');
      }
      countdown.setAttribute('aria-hidden', String(isComplete));
      officialLinkText.textContent = isComplete
        ? 'Go watch on Netflix now'
        : 'Watch An Extended Look on Netflix';
      Object.entries(values).forEach(([name, value]) => setValue(name, String(value)));
    }

    (window as Window & { testCountdown?: (seconds?: number) => void }).testCountdown = (seconds = 60) => {
      countdownTarget = new Date(Date.now() + Math.max(0, seconds) * 1000);
      countdown.removeAttribute('hidden');
      window.dispatchEvent(new CustomEvent('countdown:target', { detail: countdownTarget.getTime() }));
      updateCountdown();
    };

    updateCountdown();
    setInterval(updateCountdown, 1000);
  </script>
</Layout>
