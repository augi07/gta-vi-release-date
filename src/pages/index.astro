---
import Layout from '../layouts/Layout.astro';
import FlipClockTimer from '../components/FlipClockTimer';
---

<Layout title="GTA VI Release Countdown">
  <div class="background-slider" aria-hidden="true">
    <div class="background-slide is-active"></div><div class="background-slide" data-bg="/assets/Image2.jpg"></div>
    <div class="background-slide" data-bg="/assets/Image3.webp"></div><div class="background-slide" data-bg="/assets/Image4.webp"></div>
    <div class="background-slide" data-bg="/assets/Image5.webp"></div><div class="background-slide" data-bg="/assets/Image6.jpg"></div>
    <div class="background-slide" data-bg="/assets/Image7.webp"></div><div class="background-slide" data-bg="/assets/Image8.webp"></div>
    <div class="background-slide" data-bg="/assets/Image9.webp"></div><div class="background-slide" data-bg="/assets/Image10.webp"></div>
  </div>
  <div class="atmosphere" aria-hidden="true"></div>
  <div class="event-background" aria-hidden="true"></div>

  <main class="content">
    <header class="hero">
      <h1 class="sr-only" id="page-heading">Grand Theft Auto VI release countdown</h1>
      <p class="eyebrow" id="hero-eyebrow">The countdown is on</p>
      <img src="/assets/GTA6Logo.webp" class="gta-logo" alt="Grand Theft Auto VI" />
      <h2 class="event-title">An Extended Look</h2>
      <p class="release-line" id="release-line">Coming November 19, 2026</p>
    </header>

    <section class="countdown-grid" aria-label="Time until release" role="timer" aria-live="off">
      <div class="time-box"><div class="number" id="days"><span class="number-value">0</span></div><span class="label">Days</span></div>
      <div class="time-box"><div class="number" id="hours"><span class="number-value">0</span></div><span class="label">Hours</span></div>
      <div class="time-box"><div class="number" id="minutes"><span class="number-value">0</span></div><span class="label">Minutes</span></div>
      <div class="time-box"><div class="number" id="seconds"><span class="number-value">0</span></div><span class="label">Seconds</span></div>
      <FlipClockTimer client:only="react" />
    </section>

    <a class="official-link" id="official-link" href="https://www.rockstargames.com/VI" target="_blank" rel="noopener noreferrer">
      <span class="official-link-text">Visit the official Rockstar Games website</span>
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
  </main>

  <button class="utility-button view-switch" type="button" aria-label="Show An Extended Look countdown" title="An Extended Look">
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m9 6 6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    <span class="view-switch-hint" aria-hidden="true">Swipe left</span>
  </button>
  <button class="utility-button view-switch-test" type="button" aria-label="Temporary left button alignment test" title="Alignment test">
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m9 6 6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>

  <video class="custom-media" id="custom-video" preload="metadata" autoplay muted loop playsinline aria-hidden="true"></video>
  <img class="custom-media" id="custom-image" alt="" aria-hidden="true" />
  <iframe class="custom-media" id="custom-youtube" title="Muted GTA VI Trailer 2 background" tabindex="-1" allow="autoplay; encrypted-media" referrerpolicy="strict-origin-when-cross-origin" aria-hidden="true"></iframe>

  <button class="utility-button news-trigger" type="button" aria-label="Open GTA VI notifications" aria-controls="news-panel" aria-expanded="false">
    <span class="notification-dot" aria-hidden="true"></span>
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9ZM9.7 21h4.6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>

  <aside class="panel news-panel" id="news-panel" data-open="false" aria-hidden="true" aria-labelledby="news-title" role="dialog" inert><div class="panel-scroll">
    <div class="panel-header"><div><p class="panel-kicker">Rockstar radar</p><h2 id="news-title">Latest GTA VI updates</h2></div><button class="panel-close" type="button" aria-label="Close notifications">Close</button></div>
    <div class="x-feed">
      <div class="x-profile-card">
        <span class="x-profile-mark" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M18.9 2H22l-6.77 7.74L23.2 22h-6.24l-4.89-6.39L6.48 22H3.36l7.26-8.3L2.97 2h6.4l4.42 5.84L18.9 2Zm-1.1 17.84h1.72L8.43 4.05H6.58L17.8 19.84Z"/></svg></span>
        <span class="x-profile-copy"><strong>Rockstar Games on X</strong><small>View the latest official posts and media</small></span>
        <a class="x-profile-link" href="https://x.com/RockstarGames" target="_blank" rel="noopener noreferrer" aria-label="Open Rockstar Games on X"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
      </div>
    </div>
    <h3 class="news-subtitle">GTA VI highlights</h3>
    <ul class="news-list">
      <li class="news-item" data-expanded="false"><button class="news-card" type="button" aria-expanded="false"><img class="news-thumb" src="/extra/Jason_and_Lucia_Robbery_landscape.jpg" alt="Jason and Lucia during a robbery" loading="lazy" /><span><span class="news-meta">August 6, 2026 &middot; Rockstar</span><span class="news-title">GTA VI: An Extended Look premieres on Netflix August 27</span></span><svg class="news-chevron" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m7 9 5 5 5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></button><div class="news-detail"><div class="news-detail-inner"><img class="news-hero" src="/extra/Jason_and_Lucia_Robbery_landscape.jpg" alt="Jason and Lucia during a robbery" loading="lazy" /><div class="news-body"><p>Grand Theft Auto VI: An Extended Look premieres on Netflix on Thursday, August 27 at 3 PM ET, followed by the official Rockstar Games channels later that day.</p><a class="news-source" href="https://www.netflix.com/GTAVI" target="_blank" rel="noopener noreferrer">Open on Netflix <span aria-hidden="true">&#8599;</span></a></div></div></div></li>
      <li class="news-item" data-expanded="false"><button class="news-card" type="button" aria-expanded="false"><img class="news-thumb" src="/extra/Official_Cover_Art_landscape.jpg" alt="Grand Theft Auto VI official cover artwork" loading="lazy" /><span><span class="news-meta">June 24, 2026 &middot; Rockstar</span><span class="news-title">Pre-order GTA VI and explore the available editions</span></span><svg class="news-chevron" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m7 9 5 5 5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></button><div class="news-detail"><div class="news-detail-inner"><img class="news-hero" src="/extra/Official_Cover_Art_landscape.jpg" alt="Grand Theft Auto VI official cover artwork" loading="lazy" /><div class="news-body"><p>Rockstar detailed GTA VI pre-orders, editions and bonuses. The game is coming to PlayStation 5 and Xbox Series X|S on November 19, 2026.</p><a class="news-source" href="https://www.rockstargames.com/newswire/article/5171972o3ak5oa/pre-order-grand-theft-auto-vi-on-june-25" target="_blank" rel="noopener noreferrer">Read on Rockstar <span aria-hidden="true">&#8599;</span></a></div></div></div></li>
      <li class="news-item" data-expanded="false"><button class="news-card" type="button" aria-expanded="false"><img class="news-thumb" src="/assets/Image1.webp" alt="Grand Theft Auto VI Trailer 2 scene" loading="lazy" /><span><span class="news-meta">May 6, 2025 &middot; Rockstar</span><span class="news-title">Grand Theft Auto VI Trailer 2 is available now</span></span><svg class="news-chevron" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m7 9 5 5 5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></button><div class="news-detail"><div class="news-detail-inner"><img class="news-hero" src="/assets/Image1.webp" alt="Grand Theft Auto VI Trailer 2 scene" loading="lazy" /><div class="news-body"><p>Trailer 2 introduces more of Jason and Lucia's story and offers another look at modern-day Vice City and the wider state of Leonida.</p><a class="news-source" href="https://www.rockstargames.com/newswire/article/3928aaa9471o3a/grand-theft-auto-vi-watch-trailer-2-now" target="_blank" rel="noopener noreferrer">Watch at Rockstar <span aria-hidden="true">&#8599;</span></a></div></div></div></li>
      <li class="news-item" data-expanded="false"><button class="news-card" type="button" aria-expanded="false"><img class="news-thumb" src="/extra/Jason_and_Lucia_01_landscape.jpg" alt="Jason and Lucia in Grand Theft Auto VI" loading="lazy" /><span><span class="news-meta">December 5, 2023 &middot; Rockstar</span><span class="news-title">Watch the first Grand Theft Auto VI trailer</span></span><svg class="news-chevron" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m7 9 5 5 5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></button><div class="news-detail"><div class="news-detail-inner"><img class="news-hero" src="/extra/Jason_and_Lucia_01_landscape.jpg" alt="Jason and Lucia in Grand Theft Auto VI" loading="lazy" /><div class="news-body"><p>The first official trailer introduced Lucia, Jason, modern-day Vice City and the state of Leonida, beginning the road to Grand Theft Auto VI.</p><a class="news-source" href="https://www.rockstargames.com/VI/media" target="_blank" rel="noopener noreferrer">Watch at Rockstar <span aria-hidden="true">&#8599;</span></a></div></div></div></li>
    </ul>
    <div class="panel-footer"><span>Official sources only</span><a href="https://www.rockstargames.com/newswire" target="_blank" rel="noopener noreferrer">All Newswire <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></a></div>
  </div></aside>

  <button class="utility-button settings-trigger" type="button" aria-label="Open personalization settings" aria-controls="settings-panel" aria-expanded="false">
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19.43 12.98c.04-.32.07-.65.07-.98s-.03-.66-.08-.98l2.11-1.65a.5.5 0 0 0 .12-.64l-2-3.46a.5.5 0 0 0-.61-.22l-2.49 1a7.3 7.3 0 0 0-1.69-.98L14.5 2.42A.49.49 0 0 0 14 2h-4a.49.49 0 0 0-.49.42l-.38 2.65c-.61.25-1.17.59-1.69.98l-2.49-1a.49.49 0 0 0-.61.22l-2 3.46a.49.49 0 0 0 .12.64l2.11 1.65c-.04.32-.08.66-.08.98s.03.66.08.98l-2.11 1.65a.5.5 0 0 0-.12.64l2 3.46c.13.23.4.31.61.22l2.49-1c.52.4 1.08.73 1.69.98l.38 2.65c.04.24.24.42.49.42h4c.25 0 .46-.18.49-.42l.38-2.65a7.3 7.3 0 0 0 1.69-.98l2.49 1c.22.08.49 0 .61-.22l2-3.46a.5.5 0 0 0-.12-.64l-2.11-1.65ZM12 15.5A3.5 3.5 0 1 1 12 8a3.5 3.5 0 0 1 0 7.5Z"/></svg>
  </button>

  <aside class="panel settings-panel" id="settings-panel" data-open="false" aria-hidden="true" aria-labelledby="settings-title" role="dialog" inert><div class="panel-scroll">
    <div class="panel-header"><div><p class="panel-kicker">Vice City control</p><h2 id="settings-title">Personalize</h2></div><button class="panel-close" type="button" aria-label="Close settings">Close</button></div>
    <section class="settings-section"><h3 class="settings-section-title">Experience</h3>
      <div class="setting-group setting-row"><div class="setting-copy"><strong>Background motion</strong><small>Disable background motion</small></div><label class="switch"><input id="motion-setting" type="checkbox" aria-label="Background motion" checked /><span aria-hidden="true"></span></label></div>
      <div class="setting-group setting-row"><div class="setting-copy"><strong>Turn off notifications</strong><small>Keep notifications off</small></div><label class="switch"><input id="silent-setting" type="checkbox" aria-label="Turn off notifications" checked /><span aria-hidden="true"></span></label></div>
      <div class="setting-group"><div class="setting-copy"><strong>Background darkness</strong><small>Balance artwork and readability</small></div><div class="range-line"><input class="range" id="dim-setting" type="range" min="45" max="88" value="70" aria-label="Background darkness" /><output class="range-value" id="dim-value">70%</output></div></div>
    </section>
    <section class="settings-section"><h3 class="settings-section-title">Timer Style</h3>
      <div class="setting-group">
        <div class="setting-copy" style="margin-bottom:.75rem"><strong>Tile design</strong><small>Choose a clean, neon, or retro timer</small></div>
        <div class="style-grid" id="timer-style-grid">
          <button class="style-choice preview-glass" type="button" data-style="default" aria-pressed="true"><span class="style-preview" aria-hidden="true"><b>28</b></span><span>Glass</span></button>
          <button class="style-choice preview-neon" type="button" data-style="countdown-neon" aria-pressed="false"><span class="style-preview" aria-hidden="true"><b>28</b></span><span>Neon</span></button>
          <button class="style-choice preview-airport" type="button" data-style="countdown-airport" aria-pressed="false"><span class="style-preview" aria-hidden="true"><b>28</b></span><span>Airport</span></button>
          <button class="style-choice preview-minimal" type="button" data-style="countdown-minimal" aria-pressed="false"><span class="style-preview" aria-hidden="true"><b>28</b></span><span>Minimal</span></button>
          <button class="style-choice preview-outline" type="button" data-style="countdown-outline" aria-pressed="false"><span class="style-preview" aria-hidden="true"><b>28</b></span><span>Outline</span></button>
        </div>
      </div>
    </section>
    <section class="settings-section"><h3 class="settings-section-title">Background</h3><div class="setting-group"><div class="setting-copy"><strong>Choose the scene</strong><small>Use the slideshow or one fixed image</small></div><div class="background-grid">
      <button class="background-choice" type="button" data-background="slideshow" aria-label="Slideshow" aria-pressed="true" style="background-image:url('/assets/Image1.webp')"><span>Auto</span></button><button class="background-choice" type="button" data-background="/assets/Image3.webp" aria-label="Vice City" aria-pressed="false" style="background-image:url('/assets/Image3.webp')"><span>City</span></button><button class="background-choice" type="button" data-background="/assets/Image7.webp" aria-label="Characters" aria-pressed="false" style="background-image:url('/assets/Image7.webp')"><span>Story</span></button><button class="background-choice" type="button" data-background="/assets/Image9.webp" aria-label="Artwork" aria-pressed="false" style="background-image:url('/assets/Image9.webp')"><span>Art</span></button>
    </div><p class="settings-section-title" style="margin-top:.85rem">Extra collection</p><div class="background-grid" id="extra-backgrounds"></div><p class="settings-section-title" style="margin-top:.85rem">Videos</p><div class="background-grid" id="video-backgrounds"></div><label class="upload-button"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 16V4m0 0L7.5 8.5M12 4l4.5 4.5M4 15v4a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>Upload image or video<input class="upload-input" id="background-upload" type="file" accept="image/*,video/*" aria-label="Upload image or video" /></label></div></section>
  </div></aside>

  <footer class="site-footer">
    <div class="footer-inner">
      <p class="footer-disclaimer"><strong>Fan-made GTA VI release countdown.</strong>Not affiliated with or endorsed by Rockstar Games or Take-Two Interactive.<br />All GTA VI names, trademarks, images, artwork and videos are the property of their respective owners,<br />including Rockstar Games and Take-Two Interactive. No ownership is claimed.</p>
      <div class="footer-lower">
        <p class="footer-copyright">&copy; 2026 gtavi.ghostwebstudios.com. All rights reserved.</p>
        <nav class="social-links" aria-label="Ghost Web Studios social media">
          <a class="social-link" href="https://x.com/ghostwebstudios" target="_blank" rel="noopener noreferrer" aria-label="Ghost Web Studios on X"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.9 2H22l-6.77 7.74L23.2 22h-6.24l-4.89-6.39L6.48 22H3.36l7.26-8.3L2.97 2h6.4l4.42 5.84L18.9 2Zm-1.1 17.84h1.72L8.43 4.05H6.58L17.8 19.84Z"/></svg></a>
          <a class="social-link" href="https://www.youtube.com/@ghostwebstudios" target="_blank" rel="noopener noreferrer" aria-label="Ghost Web Studios on YouTube"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8ZM9.6 15.6V8.4l6.2 3.6-6.2 3.6Z"/></svg></a>
          <a class="social-link" href="https://www.instagram.com/ghostwebstudios" target="_blank" rel="noopener noreferrer" aria-label="Ghost Web Studios on Instagram"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="2"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg></a>
        </nav>
      </div>
    </div>
  </footer>

  <script>
    import { calculateTimeRemaining, RELEASE_DATE, EXTENDED_LOOK_DATE } from '../utils/countdown';

    let countdownTarget = RELEASE_DATE;
    const elements: Record<string, HTMLElement | null> = {
      days: document.getElementById("days"),
      hours: document.getElementById("hours"),
      minutes: document.getElementById("minutes"),
      seconds: document.getElementById("seconds")
    };
    const previous: Record<string, string> = {};

    // Only crossfade to backgrounds that the browser has fully loaded and decoded.
    const backgroundSlides = [...document.querySelectorAll<HTMLElement>(".background-slide")];
    let activeSlideIndex = 0;
    let slideshowTimer: ReturnType<typeof setTimeout>;
    if (backgroundSlides[0]) backgroundSlides[0].dataset.ready = "true";

    function prepareSlide(slide: HTMLElement): Promise<boolean> {
      if (slide.dataset.ready === "true") return Promise.resolve(true);
      if (slide.dataset.failed === "true") return Promise.resolve(false);
      if ((slide as any).loadPromise) return (slide as any).loadPromise;

      const promise = new Promise<boolean>((resolve) => {
        const image = new Image();
        image.onload = async () => {
          try {
            if (image.decode) await image.decode();
            slide.style.backgroundImage = `url("${slide.dataset.bg}")`;
            slide.dataset.ready = "true";
            resolve(true);
          } catch {
            slide.dataset.failed = "true";
            resolve(false);
          }
        };
        image.onerror = () => {
          slide.dataset.failed = "true";
          resolve(false);
        };
        image.src = slide.dataset.bg || "";
      });

      (slide as any).loadPromise = promise;
      return promise;
    }

    async function advanceBackground() {
      let nextIndex = activeSlideIndex;
      let nextSlide: HTMLElement | null = null;

      for (let attempt = 0; attempt < backgroundSlides.length - 1; attempt += 1) {
        nextIndex = (nextIndex + 1) % backgroundSlides.length;
        if (await prepareSlide(backgroundSlides[nextIndex])) {
          nextSlide = backgroundSlides[nextIndex];
          break;
        }
      }

      if (nextSlide) {
        const previousSlide = backgroundSlides[activeSlideIndex];
        nextSlide.classList.add("is-active");
        previousSlide.classList.add("is-leaving");
        previousSlide.classList.remove("is-active");
        setTimeout(() => previousSlide.classList.remove("is-leaving"), 2300);
        activeSlideIndex = nextIndex;
      }

      slideshowTimer = setTimeout(advanceBackground, 8000);
    }

    async function preloadRemainingSlides() {
      for (const slide of backgroundSlides.slice(1)) await prepareSlide(slide);
    }

    window.addEventListener("load", () => {
      if (backgroundSlides[1]) prepareSlide(backgroundSlides[1]);
      slideshowTimer = setTimeout(advanceBackground, 8000);
      if ("requestIdleCallback" in window) (window as any).requestIdleCallback(preloadRemainingSlides, { timeout: 3000 });
      else setTimeout(preloadRemainingSlides, 700);
    }, { once: true });

    const panelPairs = [
      { trigger: document.querySelector<HTMLElement>(".news-trigger")!, panel: document.getElementById("news-panel")! },
      { trigger: document.querySelector<HTMLElement>(".settings-trigger")!, panel: document.getElementById("settings-panel")! }
    ];

    const viewSwitch = document.querySelector<HTMLElement>(".view-switch")!;
    const viewSwitchTest = document.querySelector<HTMLElement>(".view-switch-test")!;
    const heroEyebrow = document.getElementById("hero-eyebrow")!;
    const releaseLine = document.getElementById("release-line")!;
    const pageHeading = document.getElementById("page-heading")!;
    const officialLink = document.getElementById("official-link") as HTMLAnchorElement;
    const officialLinkText = officialLink.querySelector<HTMLElement>(".official-link-text")!;
    const viewSwitchHint = viewSwitch.querySelector<HTMLElement>(".view-switch-hint")!;

    let viewIsSwitching = false;
    async function setCountdownView(showExtendedLook: boolean) {
      const currentlyExtended = document.body.classList.contains("extended-view");
      if (viewIsSwitching || showExtendedLook === currentlyExtended) return;
      viewIsSwitching = true;
      document.body.classList.add("view-transitioning");
      await new Promise((resolve) => setTimeout(resolve, 280));
      document.body.classList.toggle("extended-view", showExtendedLook);
      countdownTarget = showExtendedLook ? EXTENDED_LOOK_DATE : RELEASE_DATE;
      window.dispatchEvent(new CustomEvent("countdown:target", { detail: countdownTarget.getTime() }));
      heroEyebrow.textContent = showExtendedLook ? "Rockstar Games presents" : "The countdown is on";
      if (showExtendedLook) releaseLine.innerHTML = 'August 27, 2026 &middot; 3 PM ET &middot; <span class="netflix-word" role="img" aria-label="Netflix"><img src="/assets/215-2154144_transparent-background-netflix-logo.png" alt="" aria-hidden="true" /></span>';
      else releaseLine.textContent = "Coming November 19, 2026";
      pageHeading.textContent = showExtendedLook ? "GTA VI An Extended Look countdown" : "Grand Theft Auto VI release countdown";
      officialLink.href = showExtendedLook ? "https://www.netflix.com/GTAVI" : "https://www.rockstargames.com/VI";
      officialLinkText.textContent = showExtendedLook ? "Watch An Extended Look on Netflix" : "Visit the official Rockstar Games website";
      viewSwitch.setAttribute("aria-label", showExtendedLook ? "Return to GTA VI release countdown" : "Show An Extended Look countdown");
      viewSwitch.title = showExtendedLook ? "GTA VI release countdown" : "An Extended Look";
      viewSwitchHint.textContent = showExtendedLook ? "Swipe right" : "Swipe left";
      updateCountdown();
      requestAnimationFrame(() => requestAnimationFrame(() => {
        document.body.classList.remove("view-transitioning");
        setTimeout(() => { viewIsSwitching = false; }, 360);
      }));
    }

    viewSwitch?.addEventListener("click", () => {
      if (window.matchMedia("(min-width: 701px)").matches) setCountdownView(true);
      else setCountdownView(!document.body.classList.contains("extended-view"));
    });
    viewSwitchTest?.addEventListener("click", () => setCountdownView(false));

    let swipeStartX = 0;
    document.addEventListener("touchstart", (event) => {
      if (event.touches.length === 1 && !(event.target as HTMLElement).closest(".panel")) swipeStartX = event.touches[0].clientX;
    }, { passive: true });
    document.addEventListener("touchend", (event) => {
      if (!swipeStartX || (event.target as HTMLElement).closest(".panel")) return;
      const distance = event.changedTouches[0].clientX - swipeStartX;
      swipeStartX = 0;
      if (Math.abs(distance) < 65) return;
      setCountdownView(distance < 0);
    }, { passive: true });

    function setPanel(pair: { trigger: HTMLElement; panel: HTMLElement }, open: boolean, returnFocus = false) {
      if (!pair.panel || !pair.trigger) return;
      pair.panel.dataset.open = String(open);
      pair.panel.setAttribute("aria-hidden", String(!open));
      (pair.panel as any).inert = !open;
      pair.trigger.setAttribute("aria-expanded", String(open));
      if (open) pair.panel.querySelector<HTMLElement>(".panel-close")?.focus();
      else if (returnFocus) pair.trigger.focus();
    }

    panelPairs.forEach((pair) => {
      if (!pair.trigger || !pair.panel) return;
      pair.trigger.addEventListener("click", () => {
        const shouldOpen = pair.panel.dataset.open !== "true";
        panelPairs.forEach((other) => setPanel(other, false));
        setPanel(pair, shouldOpen);
        if (pair.trigger.classList.contains("news-trigger")) {
          pair.trigger.classList.add("seen");
          localStorage.setItem("gta6-news-seen", "2026-06-24");
        }
      });
      pair.panel.querySelector(".panel-close")?.addEventListener("click", () => setPanel(pair, false, true));
    });

    if (localStorage.getItem("gta6-news-seen") === "2026-06-24") document.querySelector(".news-trigger")?.classList.add("seen");
    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      const openPair = panelPairs.find((pair) => pair.panel?.dataset.open === "true");
      if (openPair) setPanel(openPair, false, true);
    });
    document.addEventListener("pointerdown", (event) => {
      panelPairs.forEach((pair) => {
        if (pair.panel?.dataset.open === "true" && !pair.panel.contains(event.target as Node) && !pair.trigger?.contains(event.target as Node)) setPanel(pair, false);
      });
    });

    let preferences: any = {};
    try { preferences = JSON.parse(localStorage.getItem("gta6-preferences") || "{}"); } catch { preferences = {}; }
    const controls = {
      motion: document.getElementById("motion-setting") as HTMLInputElement,
      silent: document.getElementById("silent-setting") as HTMLInputElement,
      dim: document.getElementById("dim-setting") as HTMLInputElement
    };
    const dimValue = document.getElementById("dim-value") as HTMLOutputElement;

    if (controls.motion) controls.motion.checked = preferences.motion ?? !window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (controls.silent) controls.silent.checked = preferences.silent ?? true;
    if (controls.dim) controls.dim.value = preferences.dim ?? 70;
    preferences.background ||= "slideshow";
    let youtubeReadyTimer: ReturnType<typeof setTimeout>;
    let backgroundSelectionId = 0;
    let uploadedMediaUrl = "";
    let uploadedMedia: File | null = null;

    function openMediaDatabase(): Promise<IDBDatabase> {
      return new Promise((resolve, reject) => {
        const request = indexedDB.open("gta6-custom-media", 1);
        request.onupgradeneeded = () => request.result.createObjectStore("media");
        request.onsuccess = () => resolve(request.result);
        request.onerror = () => reject(request.error);
      });
    }

    async function storeUploadedMedia(file: File) {
      const database = await openMediaDatabase();
      await new Promise<void>((resolve, reject) => {
        const transaction = database.transaction("media", "readwrite");
        transaction.objectStore("media").put(file, "background");
        transaction.oncomplete = () => resolve();
        transaction.onerror = () => reject(transaction.error);
        transaction.onabort = () => reject(transaction.error);
      });
      database.close();
    }

    async function readUploadedMedia(): Promise<File | null> {
      const database = await openMediaDatabase();
      const media = await new Promise<File | null>((resolve, reject) => {
        const request = database.transaction("media", "readonly").objectStore("media").get("background");
        request.onsuccess = () => resolve(request.result || null);
        request.onerror = () => reject(request.error);
      });
      database.close();
      return media;
    }

    function selectBackground(value: string, save = true) {
      const image = document.getElementById("custom-image") as HTMLImageElement;
      const video = document.getElementById("custom-video") as HTMLVideoElement;
      const youtube = document.getElementById("custom-youtube") as HTMLIFrameElement;
      const selectionId = ++backgroundSelectionId;
      clearTimeout(youtubeReadyTimer);
      youtube.onload = null;
      youtube.classList.remove("is-ready");
      document.body.classList.remove("custom-background", "custom-image-background", "custom-video-background", "custom-youtube-background", "youtube-ready", "media-loading");
      video.pause();
      video.oncanplay = null;
      youtube.src = "about:blank";
      if (value.startsWith("youtube:")) {
        const videoId = value.slice(8);
        image.src = videoId === "VQRLujxTm3c" ? "/assets/Image1.webp" : "/extra/Jason_and_Lucia_01_landscape.jpg";
        if (controls.motion?.checked) {
          youtube.onload = () => {
            youtubeReadyTimer = setTimeout(() => {
              if (selectionId !== backgroundSelectionId) return;
              youtube.classList.add("is-ready");
              document.body.classList.add("youtube-ready");
            }, 4200);
          };
          youtube.src = `https://www.youtube.com/embed/${videoId}?autoplay=1&mute=1&controls=0&autohide=1&loop=1&playlist=${videoId}&playsinline=1&rel=0&disablekb=1&fs=0&iv_load_policy=3&modestbranding=1&origin=https%3A%2F%2Fgtavi.ghostwebstudios.com`;
          document.body.classList.add("custom-background", "custom-image-background", "custom-youtube-background");
        } else {
          document.body.classList.add("custom-background", "custom-image-background");
        }
      } else if (value === "uploaded" && uploadedMedia) {
        if (uploadedMediaUrl) URL.revokeObjectURL(uploadedMediaUrl);
        uploadedMediaUrl = URL.createObjectURL(uploadedMedia);
        if (uploadedMedia.type.startsWith("video/")) {
          video.muted = true;
          video.defaultMuted = true;
          video.volume = 0;
          video.src = uploadedMediaUrl;
          video.load();
          document.body.classList.add("custom-background", "custom-video-background", "media-loading");
          video.oncanplay = () => {
            if (selectionId !== backgroundSelectionId) return;
            document.body.classList.remove("media-loading");
            video.oncanplay = null;
          };
          if (controls.motion?.checked) video.play().catch(() => {});
        } else {
          image.src = uploadedMediaUrl;
          document.body.classList.add("custom-background", "custom-image-background");
        }
      } else if (value.startsWith("video:")) {
        video.muted = true;
        video.defaultMuted = true;
        video.volume = 0;
        video.src = value.slice(6);
        video.load();
        document.body.classList.add("custom-background", "custom-video-background", "media-loading");
        video.oncanplay = () => {
          if (selectionId !== backgroundSelectionId) return;
          document.body.classList.remove("media-loading");
          video.oncanplay = null;
        };
        if (controls.motion?.checked) video.play().catch(() => {});
      } else if (value !== "slideshow") {
        image.src = value;
        document.body.classList.add("custom-background", "custom-image-background");
      }
      document.querySelectorAll<HTMLElement>(".background-choice").forEach((button) => button.setAttribute("aria-pressed", String(button.dataset.background === value)));
      if (save) preferences.background = value;
    }

    function selectTimerStyle(styleName: string, save = true) {
      const availableStyles = new Set(["default", "countdown-neon", "countdown-airport", "countdown-minimal", "countdown-outline"]);
      if (!availableStyles.has(styleName)) styleName = "default";
      document.body.classList.remove(
        "countdown-neon",
        "countdown-airport",
        "countdown-minimal",
        "countdown-outline"
      );
      if (styleName && styleName !== "default") {
        document.body.classList.add(styleName);
      }
      document.querySelectorAll<HTMLElement>("#timer-style-grid .style-choice").forEach((button) => {
        button.setAttribute("aria-pressed", String(button.dataset.style === (styleName || "default")));
      });
      if (save) {
        preferences.timerStyle = styleName;
        applyPreferences();
      }
    }

    function applyPreferences() {
      document.body.classList.toggle("motion-off", !controls.motion?.checked);
      const customVideo = document.getElementById("custom-video") as HTMLVideoElement;
      if (document.body.classList.contains("custom-video-background")) {
        if (controls.motion?.checked) customVideo.play().catch(() => {});
        else customVideo.pause();
      }
      if (preferences.background?.startsWith("youtube:")) {
        const streamVisible = document.body.classList.contains("custom-youtube-background");
        if (streamVisible !== controls.motion?.checked) selectBackground(preferences.background, false);
      }
      if (controls.dim) {
        document.documentElement.style.setProperty("--scene-dim", String(Number(controls.dim.value) / 100));
        const rangeProgress = ((Number(controls.dim.value) - Number(controls.dim.min)) / (Number(controls.dim.max) - Number(controls.dim.min))) * 100;
        controls.dim.style.setProperty("--range-progress", `${rangeProgress}%`);
        if (dimValue) dimValue.value = `${controls.dim.value}%`;
      }
      localStorage.setItem("gta6-preferences", JSON.stringify({ motion: controls.motion?.checked, silent: controls.silent?.checked, dim: controls.dim?.value, background: preferences.background, timerStyle: preferences.timerStyle }));
    }

    const extraBackgrounds = [
      ["Boobie Ike", "Boobie_Ike_landscape.jpg"], ["Brian Heder", "Brian_Heder_landscape.jpg"],
      ["Cal Hampton", "Cal_Hampton_landscape.jpg"], ["Dre'Quan", "DreQuan_Priest_landscape.jpg"],
      ["Jason & Lucia", "Jason_and_Lucia_01_landscape.jpg"], ["Jason & Lucia", "Jason_and_Lucia_03_landscape.jpg"],
      ["Motel", "Jason_and_Lucia_Motel_landscape.jpg"], ["Robbery", "Jason_and_Lucia_Robbery_landscape.jpg"],
      ["Cover Art", "Official_Cover_Art_landscape.jpg"], ["Raul", "Raul_Bautista_landscape.jpg"],
      ["Real Dimez", "Real_Dimez_landscape.jpg"]
    ];
    const extraGrid = document.getElementById("extra-backgrounds");
    if (extraGrid) {
      extraBackgrounds.forEach(([label, filename]) => {
        const path = `/extra/${filename}`;
        const button = document.createElement("button");
        button.className = "background-choice";
        button.type = "button";
        button.dataset.background = path;
        button.setAttribute("aria-label", label);
        button.setAttribute("aria-pressed", String(preferences.background === path));
        const preview = document.createElement("img");
        preview.src = `/extra/thumbs/${filename}`;
        preview.alt = "";
        preview.loading = "lazy";
        const caption = document.createElement("span");
        caption.textContent = label;
        button.append(preview, caption);
        extraGrid.append(button);
      });
    }

    const videoBackgrounds = [
      ["Trailer 2", "VQRLujxTm3c"],
      ["Trailer 1", "QdBZY2fkU-0"]
    ];
    const videoGrid = document.getElementById("video-backgrounds");
    if (videoGrid) {
      videoBackgrounds.forEach(([label, videoId]) => {
        const path = `youtube:${videoId}`;
        const button = document.createElement("button");
        button.className = "background-choice video-choice";
        button.type = "button";
        button.dataset.background = path;
        button.setAttribute("aria-label", `${label} video background`);
        button.setAttribute("aria-pressed", String(preferences.background === path));
        const preview = document.createElement("img");
        preview.src = `https://i.ytimg.com/vi/${videoId}/hqdefault.jpg`;
        preview.alt = "";
        preview.loading = "lazy";
        const caption = document.createElement("span");
        caption.textContent = `▶ ${label}`;
        button.append(preview, caption);
        videoGrid.append(button);
      });
    }

    Object.values(controls).forEach((control) => control?.addEventListener("input", applyPreferences));
    document.querySelectorAll<HTMLElement>(".background-choice").forEach((button) => button.addEventListener("click", () => { selectBackground(button.dataset.background || "slideshow"); applyPreferences(); }));

    const backgroundUpload = document.getElementById("background-upload") as HTMLInputElement;
    backgroundUpload?.addEventListener("change", async (event) => {
      const target = event.target as HTMLInputElement;
      const file = target.files?.[0];
      if (!file) return;
      try {
        await storeUploadedMedia(file);
        uploadedMedia = file;
        preferences.background = "uploaded";
        selectBackground("uploaded", false);
        applyPreferences();
      } catch (error) {
        console.error("Could not save the custom background", error);
        alert("This file could not be saved. Try a smaller image or video.");
      }
      target.value = "";
      target.blur();
    });

    document.querySelectorAll<HTMLElement>(".news-card").forEach((button) => button.addEventListener("click", () => {
      const item = button.closest<HTMLElement>(".news-item");
      if (!item) return;
      const expanded = item.dataset.expanded !== "true";
      document.querySelectorAll<HTMLElement>(".news-item").forEach((other) => { other.dataset.expanded = "false"; other.querySelector(".news-card")?.setAttribute("aria-expanded", "false"); });
      item.dataset.expanded = String(expanded);
      button.setAttribute("aria-expanded", String(expanded));
    }));

    document.querySelectorAll<HTMLElement>("#timer-style-grid .style-choice").forEach((button) => {
      button.addEventListener("click", () => selectTimerStyle(button.dataset.style || "default"));
    });

    async function restoreBackground() {
      if (preferences.background === "uploaded") {
        try { uploadedMedia = await readUploadedMedia(); }
        catch (error) { console.error("Could not restore the custom background", error); }
        if (!uploadedMedia) preferences.background = "slideshow";
      }
      selectBackground(preferences.background, false);
      selectTimerStyle(preferences.timerStyle || "default", false);
      applyPreferences();
    }
    restoreBackground();

    function setValue(name: string, value: string) {
      if (previous[name] === value) return;
      const element = elements[name];
      if (!element) return;
      element.setAttribute("aria-label", value);
      element.querySelector<HTMLElement>(".number-value")!.textContent = value;
      element.classList.remove("tick");
      void element.offsetWidth;
      element.classList.add("tick");
      window.dispatchEvent(new CustomEvent(`countdown:${name}`, { detail: value }));
      previous[name] = value;
    }

    function updateCountdown() {
      const values = calculateTimeRemaining(countdownTarget);
      Object.entries(values).forEach(([name, value]) => setValue(name, String(value)));
    }

    updateCountdown();
    setInterval(updateCountdown, 1000);
  </script>
</Layout>
